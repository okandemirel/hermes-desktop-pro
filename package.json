{
  "name": "hermes-desktop-pro",
  "productName": "Hermes Desktop Pro",
  "version": "2.1.0",
  "description": "Premium desktop app for Hermes Desktop Pro — all features, OpenCode, multi-provider, visual innovation",
  "main": "./out/main/index.js",
  "author": "Hermes Desktop Pro",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:app": "npm run build && electron-builder --mac --dir",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:linux": "npm run build && electron-builder --linux",
    "build:rpm": "npm run build && electron-builder --linux --rpm",
    "build:all": "npm run build && electron-builder --mac --linux --win",
    "open:mac": "node scripts/open-built-mac-app.mjs",
    "start:mac": "npm run build:mac:app && npm run open:mac"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "i18next": "^25.6.0",
    "lucide-react": "^1.7.0",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.2.6",
    "vitest": "^4.1.4"
  }
}
